{
  "$schema": "./config.schema.json",
  "version": 1,
  "chatgpt_review": true,
  "quota": {
    "auto_refresh": true,
    "interval_minutes": 15
  },
  "free_channel_probe": {
    "enabled": true,
    "interval_minutes": 10
  },
  "janitor": {
    "enabled": true,
    "ttl_hours": 24,
    "interval_hours": 6
  },
  "engines": {
    "claude": {
      "enabled": true,
      "kind": "claude"
    },
    "codex": {
      "enabled": true,
      "kind": "codex"
    },
    "grok": {
      "enabled": true,
      "kind": "grok"
    },
    "opencode": {
      "enabled": true,
      "kind": "opencode"
    },
    "pi": {
      "enabled": true,
      "kind": "pi"
    },
    "qoder": {
      "enabled": true,
      "kind": "qodercli"
    },
    "dsh": {
      "enabled": true,
      "kind": "dsh"
    }
  },
  "owners": {
    "claude_owner": {
      "enabled": true,
      "model": "claude-opus-5-5",
      "effort": "high",
      "workers": [
        "claude_worker",
        "qoder_worker",
        "opencode_worker",
        "grok_worker"
      ],
      "max_parallel": 4,
      "channel": "default_claude"
    },
    "codex_owner": {
      "enabled": true,
      "model": "gpt-6-astra",
      "effort": "high",
      "workers": [
        "codex_worker",
        "qoder_worker",
        "opencode_worker",
        "grok_worker"
      ],
      "max_parallel": 4,
      "channel": "default_codex"
    },
    "pi_owner": {
      "enabled": false,
      "model": "glm-5.3-flash",
      "effort": "high",
      "workers": [
        "pi_worker"
      ],
      "max_parallel": 1,
      "channel": "default_pi"
    }
  },
  "workers": {
    "claude_worker": {
      "enabled": true,
      "model": "sonnet",
      "effort": "high",
      "description": "Default Claude Code worker (Sonnet).",
      "channels": [
        "default_claude"
      ]
    },
    "codex_worker": {
      "enabled": true,
      "model": "gpt-6.1-sol",
      "effort": "high",
      "description": "Default Codex worker (gpt-6.1-sol).",
      "channels": [
        "default_codex"
      ]
    },
    "grok_worker": {
      "enabled": false,
      "model": "grok-4.7",
      "effort": "high",
      "description": "Example Grok worker (grok-4.7).",
      "channels": [
        "default_grok"
      ]
    },
    "qoder_worker": {
      "enabled": false,
      "model": "Qwen3.8-Flash",
      "effort": "xhigh",
      "description": "Free worker (Qwen3.8-Flash via qodercli).",
      "free_channel": true,
      "channels": [
        "default_qoder"
      ]
    },
    "opencode_worker": {
      "enabled": false,
      "model": "opencode/glm-5.3-flash-free",
      "effort": "max",
      "description": "Free worker (glm-5.3-flash-free via opencode). Its TUI uses the variant remembered in ~/.local/state/opencode/model.json, which must match effort.",
      "free_channel": true,
      "channels": [
        "default_opencode"
      ]
    },
    "pi_worker": {
      "enabled": false,
      "model": "glm-5.3-flash",
      "effort": "high",
      "description": "Disabled Pi worker template (glm-5.3-flash). Configure its account and enable this worker before dispatch.",
      "channels": [
        "default_pi"
      ]
    },
    "dsh_worker": {
      "enabled": false,
      "model": "deepseek-flash",
      "effort": "high",
      "description": "DeepSeek Harness worker (deepseek-flash via dsh headless). Uses the DeepSeek API key saved in dsh settings or DEEPSEEK_API_KEY.",
      "channels": [
        "default_dsh"
      ]
    }
  },
  "herdr": {
    "max_wait_minutes": 15,
    "max_command_minutes": 30
  },
  "channels": {
    "default_claude": {
      "engine": "claude",
      "label": "claude \u5b98\u65b9\u8ba2\u9605",
      "enabled": true,
      "kind": "subscription",
      "quota_refresh": true
    },
    "default_codex": {
      "engine": "codex",
      "label": "codex \u5b98\u65b9\u8ba2\u9605",
      "enabled": true,
      "kind": "subscription",
      "quota_refresh": true
    },
    "default_grok": {
      "engine": "grok",
      "label": "grok \u5b98\u65b9\u8ba2\u9605",
      "enabled": true,
      "kind": "subscription",
      "quota_refresh": true
    },
    "default_opencode": {
      "engine": "opencode",
      "label": "opencode \u5b98\u65b9\u8ba2\u9605",
      "enabled": true,
      "kind": "subscription",
      "quota_refresh": false
    },
    "default_pi": {
      "engine": "pi",
      "label": "pi API\uff08\u5f85\u5bfc\u5165\uff09",
      "enabled": true,
      "kind": "api",
      "quota_refresh": false
    },
    "default_qoder": {
      "engine": "qoder",
      "label": "qoder \u5b98\u65b9\u8ba2\u9605",
      "enabled": true,
      "kind": "subscription",
      "quota_refresh": false
    },
    "default_dsh": {
      "engine": "dsh",
      "label": "dsh API\uff08\u5f85\u5bfc\u5165\uff09",
      "enabled": true,
      "kind": "api",
      "quota_refresh": false
    }
  }
}
