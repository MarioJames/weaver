{
  "$schema": "./config.schema.json",
  "version": 1,
  "chatgpt_review": true,
  "quota": { "auto_refresh": true, "interval_minutes": 15 },
  "free_channel_probe": { "enabled": true, "interval_minutes": 10 },
  "janitor": { "enabled": true, "ttl_hours": 24, "interval_hours": 6 },
  "engines": {
    "claude": { "enabled": true, "kind": "claude", "quota_refresh": true },
    "codex": { "enabled": true, "kind": "codex", "quota_refresh": true },
    "grok": { "enabled": false, "kind": "grok", "quota_refresh": true },
    "opencode": { "enabled": false, "kind": "opencode", "quota_refresh": false },
    "pi": { "enabled": false, "kind": "pi", "quota_refresh": false },
    "qoder": { "enabled": false, "kind": "qodercli", "quota_refresh": false },
    "dsh": { "enabled": false, "kind": "dsh", "quota_refresh": false }
  },
  "owners": {
    "claude_owner": {
      "enabled": true,
      "engine": "claude",
      "model": "claude-opus-5-5",
      "effort": "high",
      "workers": ["claude_worker", "qoder_worker", "opencode_worker", "grok_worker"],
      "max_parallel": 4
    },
    "codex_owner": {
      "enabled": true,
      "engine": "codex",
      "model": "gpt-6-astra",
      "effort": "high",
      "workers": ["codex_worker", "qoder_worker", "opencode_worker", "grok_worker"],
      "max_parallel": 4
    },
    "pi_owner": {
      "enabled": false,
      "engine": "pi",
      "model": "glm-5.3-flash",
      "effort": "high",
      "workers": ["pi_worker"],
      "max_parallel": 1
    }
  },
  "workers": {
    "claude_worker": { "enabled": true, "engine": "claude", "model": "sonnet", "effort": "high", "description": "Default Claude Code worker (Sonnet)." },
    "codex_worker": { "enabled": true, "engine": "codex", "model": "gpt-6.1-sol", "effort": "high", "description": "Default Codex worker (gpt-6.1-sol)." },
    "grok_worker": { "enabled": false, "engine": "grok", "model": "grok-4.7", "effort": "high", "description": "Example Grok worker (grok-4.7)." },
    "qoder_worker": { "enabled": false, "engine": "qoder", "model": "Qwen3.8-Flash", "effort": "xhigh", "description": "Free worker (Qwen3.8-Flash via qodercli).", "free_channel": true },
    "opencode_worker": { "enabled": false, "engine": "opencode", "model": "opencode/glm-5.3-flash-free", "effort": "max", "description": "Free worker (glm-5.3-flash-free via opencode). Its TUI uses the variant remembered in ~/.local/state/opencode/model.json, which must match effort.", "free_channel": true },
    "pi_worker": { "enabled": false, "engine": "pi", "model": "glm-5.3-flash", "effort": "high", "description": "Disabled Pi template (glm-5.3-flash). Enable the engine and this worker before dispatch." },
    "dsh_worker": { "enabled": false, "engine": "dsh", "model": "deepseek-flash", "effort": "high", "description": "DeepSeek Harness worker (deepseek-flash via dsh headless). Uses the DeepSeek API key saved in dsh settings or DEEPSEEK_API_KEY." }
  },
  "herdr": { "max_wait_minutes": 15 }
}
