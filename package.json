{
  "name": "weaver",
  "version": "0.7.5",
  "private": true,
  "description": "Local control plane for owner-led agent work",
  "license": "Apache-2.0",
  "main": "dist/cli/main.mjs",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/cli/main.ts web --dev --no-open --port 4738 --data-dir .weaver-dev",
    "start": "node dist/cli/main.mjs web",
    "build": "tsc --noEmit && vite build && node scripts/build-main.mjs",
    "dist": "npm run build && node scripts/build-standalone.mjs --all",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'tests/**/*.test.ts'",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@larksuite/channel": "0.7.1",
    "@larksuiteoapi/node-sdk": "1.76.0",
    "@lobehub/fluent-emoji": "^4.1.1",
    "@lobehub/icons": "^5.23.1",
    "@lobehub/ui": "^5.64.4",
    "antd": "^6.6.6",
    "antd-style": "^4.1.0",
    "axios": "1.20.0",
    "croner": "10.0.1",
    "lucide-react": "^1.59.0",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "virtua": "^0.52.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "type": "module",
  "bin": {
    "weaver": "dist/cli/main.mjs"
  }
}
