{
  "name": "weaver",
  "version": "0.7.12",
  "private": true,
  "description": "Local control plane for owner-led agent work",
  "license": "Apache-2.0",
  "main": "dist/cli/main.mjs",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/cli/main.ts web --dev --no-open --port 4738 --data-dir .weaver-dev",
    "dev:real": "node scripts/dev-real.mjs",
    "start": "node dist/cli/main.mjs web",
    "build": "tsc --noEmit && vite build && node scripts/build-main.mjs",
    "dist": "npm run build && node scripts/build-standalone.mjs --all",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --import ./scripts/register-stylex.mjs --test 'tests/**/*.test.ts'",
    "check": "npm run typecheck && npm test && npm run build",
    "test:real": "node scripts/test-real-engines.mjs"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@larksuite/channel": "0.7.1",
    "@larksuiteoapi/node-sdk": "1.76.0",
    "@lobehub/fluent-emoji": "^5.0.0",
    "@lobehub/icons": "^6.9.0",
    "@lobehub/ui": "^6.9.0",
    "@stylexjs/stylex": "0.19.1",
    "axios": "1.20.0",
    "croner": "10.0.1",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^1.59.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smol-toml": "^1.9.1",
    "virtua": "^0.53.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@stylexjs/babel-plugin": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unplugin": "^2.3.11",
    "vite": "^8.3.4"
  },
  "type": "module",
  "bin": {
    "weaver": "dist/cli/main.mjs"
  }
}
